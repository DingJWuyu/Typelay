{
  "manifest_version": 3,
  "name": "TypeLay local input",
  "version": "0.1.0",
  "description": "Connect ordinary webpage inputs to the local TypeLay client.",
  "icons": {
    "16": "icons/typelay-16.png",
    "48": "icons/typelay-48.png",
    "128": "icons/typelay-128.png"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "typelay@typelay.local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "editor-bridge.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "editor-adapter.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
