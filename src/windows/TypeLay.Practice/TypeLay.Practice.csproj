<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <TypeLayUiFontRoot Condition="'$(TypeLayUiFontRoot)' == ''">$(MSBuildThisFileDirectory)../../../artifacts/ui-fonts</TypeLayUiFontRoot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/inter/Inter-Regular.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/inter/Inter-Medium.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-13-Regular.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-14-Regular.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-15-Regular.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-16-Regular.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-17-Regular.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-18-Regular.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-19-Regular.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-30-Medium.ttf" LogicalName="UI.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ValidatePracticeUiFonts" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TypeLayUiFontRoot)/manifest.json')" Text="Prepare the complete locked offline UI font bundle before building Practice." />
    <Error Condition="!Exists('%(EmbeddedResource.Identity)')" Text="Missing offline practice font: %(EmbeddedResource.Identity). Run python eng/fonts/prepare.py --output artifacts/ui-fonts." />
  </Target>
  <ItemGroup>
    <Compile Include="../shared/WindowsInterruptClock.cs" Link="Windows/WindowsInterruptClock.cs" />
    <Compile Include="../shared/OwnedPracticeField.cs" Link="Windows/OwnedPracticeField.cs" />
    <Compile Include="../shared/OwnedPracticeAcceptanceProtocol.cs" Link="Windows/OwnedPracticeAcceptanceProtocol.cs" />
    <Compile Include="../shared/PracticeProgressPipe.cs" Link="Windows/PracticeProgressPipe.cs" />
    <ProjectReference Include="../TypeLay.Broker/TypeLay.Broker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TypeLay.Windows.Contracts/TypeLay.Windows.Contracts.csproj" />
    <ProjectReference Include="../../shared/TypeLay.Runtime/TypeLay.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="../../../artifacts/native/TypeLay.NativeInput.dll" Link="TypeLay.NativeInput.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
