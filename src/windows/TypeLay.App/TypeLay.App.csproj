<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TypeLay.App</AssemblyName>
    <TypeLayUiFontRoot Condition="'$(TypeLayUiFontRoot)' == ''">$(MSBuildThisFileDirectory)../../../artifacts/ui-fonts</TypeLayUiFontRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/OwnedPracticeAcceptanceProtocol.cs" Link="Windows/OwnedPracticeAcceptanceProtocol.cs" />
    <Compile Include="../shared/PracticeProgressPipe.cs" Link="Windows/PracticeProgressPipe.cs" />
    <Compile Include="../shared/WindowsInterruptClock.cs" Link="Windows/WindowsInterruptClock.cs" />
    <Compile Include="../shared/BrowserPeerIdentity.cs" Link="Windows/BrowserPeerIdentity.cs" />
    <ProjectReference Include="../TypeLay.Practice/TypeLay.Practice.csproj" ReferenceOutputAssembly="false" OutputItemType="_PracticeBuildOutput" />
    <ProjectReference Include="../TypeLay.Windows.Contracts/TypeLay.Windows.Contracts.csproj" />
    <ProjectReference Include="../../shared/TypeLay.Runtime/TypeLay.Runtime.csproj" />
    <ProjectReference Include="../../shared/TypeLay.Protocol/TypeLay.Protocol.csproj" />
  </ItemGroup>
  <!-- Prepared and hash-verified by the public build entry point. Direct dotnet
       builds require the same offline bundle; never silently ship Latin-only UI. -->
  <ItemGroup>
    <Resource Include="$(TypeLayUiFontRoot)/inter/Inter-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/inter/Inter-Regular.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/inter/Inter-SemiBold.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-sans/NotoSansJP-Medium.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-sans/NotoSansJP-Regular.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-sans/NotoSansKR-Medium.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-sans/NotoSansKR-Regular.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-sans/NotoSansSC-Medium.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-sans/NotoSansSC-Regular.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-sans/TypeLayNotoSansSC-SemiBold.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-serif/NotoSerifJP-Medium.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-serif/NotoSerifJP-Regular.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-serif/NotoSerifKR-Medium.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-serif/NotoSerifKR-Regular.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-serif/NotoSerifSC-Medium.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/noto-serif/NotoSerifSC-Regular.otf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-13-Regular.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-14-Regular.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-15-Regular.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-16-Regular.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-17-Regular.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-18-Regular.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-19-Regular.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-11-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-13.5-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-15-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-17-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-18-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-20-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-22-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-26-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Resource Include="$(TypeLayUiFontRoot)/source-serif/TypeLaySerif-30-Medium.ttf" Link="UI/Fonts/%(Filename)%(Extension)" />
    <Content Include="$(TypeLayUiFontRoot)/**/LICENSE.*" Link="UI/Fonts/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateUiFontBundle" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TypeLayUiFontRoot)/manifest.json')" Text="The complete offline UI font bundle is required. Run python eng/fonts/prepare.py --output artifacts/ui-fonts, or set TypeLayUiFontRoot to a verified bundle." />
    <Error Condition="!Exists('%(Resource.Identity)')" Text="Missing offline UI font: %(Resource.Identity). Prepare the complete locked bundle before building." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="TypeLay.DesktopFixture" />
    <InternalsVisibleTo Include="TypeLay.App.Tests" />
  </ItemGroup>
  <Target Name="CopyPracticeHostForDevelopment" AfterTargets="Build">
    <Error Condition="'@(_PracticeBuildOutput->Count())' != '1'" Text="The Practice project must provide exactly one build output." />
    <PropertyGroup>
      <_PracticeOutputDirectory>@(_PracticeBuildOutput->'%(RootDir)%(Directory)')</_PracticeOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_PracticeFiles Include="$(_PracticeOutputDirectory)TypeLay.Practice.*" />
      <_PracticeFiles Include="$(_PracticeOutputDirectory)TypeLay.NativeInput.dll" Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    <Copy SourceFiles="@(_PracticeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
