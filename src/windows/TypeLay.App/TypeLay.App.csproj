<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TypeLay.App</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/OwnedPracticeAcceptanceProtocol.cs" Link="Windows/OwnedPracticeAcceptanceProtocol.cs" />
    <Compile Include="../shared/PracticeProgressPipe.cs" Link="Windows/PracticeProgressPipe.cs" />
    <Compile Include="../shared/WindowsInterruptClock.cs" Link="Windows/WindowsInterruptClock.cs" />
    <Compile Include="../shared/BrowserPeerIdentity.cs" Link="Windows/BrowserPeerIdentity.cs" />
    <ProjectReference Include="../TypeLay.Practice/TypeLay.Practice.csproj" ReferenceOutputAssembly="false" OutputItemType="_PracticeBuildOutput" />
    <ProjectReference Include="../TypeLay.Windows.Contracts/TypeLay.Windows.Contracts.csproj" />
    <ProjectReference Include="../../shared/TypeLay.Runtime/TypeLay.Runtime.csproj" />
    <ProjectReference Include="../../shared/TypeLay.Protocol/TypeLay.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TypeLay.DesktopFixture" />
    <InternalsVisibleTo Include="TypeLay.App.Tests" />
  </ItemGroup>
  <Target Name="CopyPracticeHostForDevelopment" AfterTargets="Build">
    <Error Condition="'@(_PracticeBuildOutput->Count())' != '1'" Text="The Practice project must provide exactly one build output." />
    <PropertyGroup>
      <_PracticeOutputDirectory>@(_PracticeBuildOutput->'%(RootDir)%(Directory)')</_PracticeOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_PracticeFiles Include="$(_PracticeOutputDirectory)TypeLay.Practice.*" />
      <_PracticeFiles Include="$(_PracticeOutputDirectory)TypeLay.NativeInput.dll" Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    <Copy SourceFiles="@(_PracticeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
