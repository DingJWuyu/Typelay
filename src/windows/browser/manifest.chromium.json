{
  "manifest_version": 3,
  "name": "TypeLay local input",
  "version": "0.1.0",
  "description": "Connect ordinary webpage inputs to the local TypeLay client.",
  "icons": {
    "16": "icons/typelay-16.png",
    "48": "icons/typelay-48.png",
    "128": "icons/typelay-128.png"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "minimum_chrome_version": "111",
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/inter/*.ttf",
        "fonts/source-serif/*.ttf"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
