// Generated bytecode must use the pinned Microsoft FXC in build-sheet-shader.ps1.
// CSS Filter Effects saturate(1.8), operating on premultiplied sRGB samples.
// https://www.w3.org/TR/filter-effects-1/#feColorMatrixElement
sampler2D Input : register(s0);

float4 main(float2 uv : TEXCOORD) : COLOR
{
    float4 pixel = tex2D(Input, uv);
    float3 rgb = float3(
        dot(pixel.rgb, float3(1.6296, -0.5720, -0.0576)),
        dot(pixel.rgb, float3(-0.1704, 1.2280, -0.0576)),
        dot(pixel.rgb, float3(-0.1704, -0.5720, 1.7424)));
    // For alpha a >= 0: a * clamp(M * (rgb / a), 0, 1)
    // equals clamp(M * rgb, 0, a). This also handles a == 0 without division.
    return float4(min(max(rgb, 0.0), pixel.aaa), pixel.a);
}
