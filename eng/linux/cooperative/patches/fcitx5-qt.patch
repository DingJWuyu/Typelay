+        typeid(*source) != typeid(QLineEdit) || typeid(*next) != typeid(QLineEdit) ||
+        !lastWindow_ || source->window()->windowHandle() != lastWindow_ ||
+        next->window()->windowHandle() != lastWindow_ || focusWindowWrapper() != lastWindow_ ||
+        !tlFields_.contains(source) || tlPendingDbus || tlPendingForward || tlOutputDepth ||
+        tlDrainingKeys_ || !tlKeyQueue_.empty() || !preeditList_.isEmpty() || !commitPreedit_.isEmpty() ||
+        (xkbComposeState_ && xkb_compose_state_get_status(xkbComposeState_.data()) ==
+         XKB_COMPOSE_COMPOSING)) return candidate;
+    auto *hybrid = validICByWindow(lastWindow_);
+    auto *proxy = hybrid ? hybrid->typelayProxy() : nullptr;
+    const auto context = tlContexts_.value(hybrid);
+    if (!proxy || !proxy->isValid() || proxy->typelayOutputDepth() ||
+        context.proxy != proxy || !context.generation ||
+        context.remoteGeneration != proxy->typelayGeneration()) return candidate;
+    const auto field = tlFields_.value(source);
+    const auto epoch = tlEpoch_;
+    const auto queueEpoch = tlQueueEpoch;
+    QPointer<QObject> old(source), nextObject(destination);
+    QPointer<FcitxQtInputContextProxy> remote(proxy);
+    QPointer<QFcitxPlatformInputContext> self(this);
+    quint64 serial = 0;
+    bool known = false, pending = false, composing = false, focused = false;
+    tlInspecting_ = true;
+    const bool ok = proxy->typelayProbe(serial, known, pending, composing, focused);
+    if (!self) return {};
+    tlInspecting_ = false;
+    if (!ok || !known || pending || composing || !focused || !old || !nextObject || !remote ||
+        epoch != tlEpoch_ || queueEpoch != tlQueueEpoch || old != lastObject_ || old != tlBound_ ||
+        nextObject != focusObjectWrapper() || proxy->typelayGeneration() != context.remoteGeneration ||
+        serial != proxy->typelayAppliedSerial()) return {};
+    candidate.source = old;
+    candidate.destination = nextObject;
+    candidate.window = lastWindow_;
+    candidate.proxy = remote;
+    candidate.remoteGeneration = context.remoteGeneration;
+    candidate.state.contextGeneration = context.generation;
+    candidate.state.fieldGeneration = field.generation;
+    candidate.state.inputEpoch = field.inputEpoch;
+    candidate.state.serverSerial = serial;
+    candidate.state.appliedSerial = serial;
+    return candidate;
+}
+
+void QFcitxPlatformInputContext::tlFinishDetach(TlDetached candidate) {
+    if (!candidate.source) return;
+    const auto field = tlFields_.value(candidate.source);
+    const bool valid = candidate.destination && candidate.proxy && candidate.window &&
+        candidate.destination == tlBound_ && candidate.destination == focusObjectWrapper() &&
+        candidate.window == lastWindow_ && candidate.window == focusWindowWrapper() &&
+        candidate.proxy->isValid() && !candidate.proxy->typelayOutputDepth() &&
+        candidate.proxy->typelayGeneration() == candidate.remoteGeneration &&
+        candidate.proxy->typelayAppliedSerial() == candidate.state.appliedSerial &&
+        field.generation == candidate.state.fieldGeneration && field.inputEpoch == candidate.state.inputEpoch &&
+        !tlPendingDbus && !tlPendingForward && !tlOutputDepth && !tlDrainingKeys_ && tlKeyQueue_.empty() &&
+        preeditList_.isEmpty() && commitPreedit_.isEmpty() &&
+        (!xkbComposeState_ || xkb_compose_state_get_status(xkbComposeState_.data()) != XKB_COMPOSE_COMPOSING);
+    if (!valid) {
+        if (candidate.source != tlBound_ &&
+            candidate.source->property(TypeLayFcitxQtProviderPropertyV1).value<QObject *>() == this)
+            candidate.source->setProperty(TypeLayFcitxQtProviderPropertyV1, QVariant());
+        return;
+    }
+    candidate.state.flags = TlQtKnown | TlQtDetached;
+    candidate.state.epoch = ++tlDetachedEpoch_;
+    tlDetached_ = candidate;
+    candidate.source->setProperty(TypeLayFcitxQtProviderPropertyV1,
+                                  QVariant::fromValue(static_cast<QObject *>(this)));
+    Q_EMIT typelayStateChangedV1(candidate.source, TlQtFocus);
+}
+
+bool QFcitxPlatformInputContext::tlDetachedValid(QObject *actual) const {
+    const auto &record = tlDetached_;
+    auto *source = qobject_cast<QLineEdit *>(actual);
+    auto *destination = qobject_cast<QLineEdit *>(record.destination.data());
+    auto *hybrid = record.window ? validICByWindow(record.window) : nullptr;
+    const auto context = tlContexts_.value(hybrid);
+    return tlCooperate() && !syncMode_ && !destroy_ && !tlInspecting_ &&
+        QThread::currentThread() == thread() && source && destination &&
+        record.source == actual && record.state.flags == (TlQtKnown | TlQtDetached) &&
+        source->metaObject() == &QLineEdit::staticMetaObject && typeid(*source) == typeid(QLineEdit) &&
+        destination == tlBound_ && destination == focusObjectWrapper() &&
+        record.window && record.window == lastWindow_ && record.window == focusWindowWrapper() &&
+        source->window()->windowHandle() == record.window &&
+        destination->window()->windowHandle() == record.window &&
+        source->property(TypeLayFcitxQtProviderPropertyV1).value<QObject *>() == this &&
+        record.proxy && record.proxy->isValid() && context.proxy == record.proxy &&
+        record.proxy->typelayGeneration() == record.remoteGeneration &&
+        context.generation == record.state.contextGeneration &&
+        tlFields_.value(actual).generation == record.state.fieldGeneration &&
+        tlFields_.value(actual).inputEpoch == record.state.inputEpoch;
+}
+
+// TypeLay 2026-10-13: upstream clears the live preedit list on commit,
+// while its preedit_ cursor cache can remain stale after the empty update is elided.
+bool QFcitxPlatformInputContext::tlLocalClear(QObject *actual) const {
+    return tlCooperate() && !syncMode_ && !destroy_ && actual &&
+        QThread::currentThread() == thread() && actual == tlBound_ &&
+        actual == focusObjectWrapper() && lastWindow_ &&
+        lastWindow_ == focusWindowWrapper() && !tlPendingDbus &&
+        !tlPendingForward && !tlOutputDepth && preeditList_.isEmpty() &&
+        commitPreedit_.isEmpty() && (!xkbComposeState_ ||
+        xkb_compose_state_get_status(xkbComposeState_.data()) != XKB_COMPOSE_COMPOSING);
+}
+
+bool QFcitxPlatformInputContext::inspect(QObject *actual, TypeLayFcitxQtStateV1 *state) {
+    if (state && state->size == sizeof(*state) && state->version == 1 &&
+        actual && actual == tlDetached_.source) {
+        if (!tlDetachedValid(actual)) { tlRevokeDetached(); return false; }
+        *state = tlDetached_.state;
+        tlDetached_.inspected = true;
+        return true;
+    }
+    if (!state || state->size != sizeof(*state) || state->version != 1 ||
+        tlInspecting_ || !tlCooperate() || syncMode_ || destroy_ ||
+        tlPendingDbus || tlPendingForward || tlOutputDepth ||
+        QThread::currentThread() != thread() || !actual || actual != tlBound_ ||
+        actual != focusObjectWrapper() || !lastWindow_ || lastWindow_ != focusWindowWrapper())
+        return false;
+    auto *hybrid = validICByWindow(lastWindow_);
+    auto *proxy = hybrid ? hybrid->typelayProxy() : nullptr;
+    if (!proxy || !proxy->isValid() || proxy->typelayOutputDepth()) return false;
+    QPointer<QObject> object(actual);
+    QPointer<QFcitxPlatformInputContext> self(this);
+    QPointer<FcitxQtInputContextProxy> remote(proxy);
+    const auto epoch = tlEpoch_;
+    const auto queueEpoch = tlQueueEpoch;
+    const auto generation = proxy->typelayGeneration();
+    quint64 serial = 0;
+    bool known = false, pending = false, composing = false, focused = false;
+    tlInspecting_ = true;
+    const bool ok = proxy->typelayProbe(serial, known, pending, composing, focused);
+    if (!self) return false;
+    tlInspecting_ = false;
+    if (!ok || !object || !remote || epoch != tlEpoch_ || queueEpoch != tlQueueEpoch ||
+        actual != tlBound_ || generation != proxy->typelayGeneration()) return false;
+    auto &context = tlContexts_[hybrid];
+    if (context.proxy != proxy || context.remoteGeneration != generation || !context.generation) {
+        const bool newProxy = context.proxy != proxy;
+        context = {proxy, generation, ++tlNextGeneration_};
+        connect(hybrid, &QObject::destroyed, this, [this, hybrid]() { tlContexts_.remove(hybrid); });
+        if (newProxy) connect(proxy, &QObject::destroyed, this, [this]() { tlChanged(TlQtBinding); });
+    }
+    const auto field = tlFields_.value(actual);
+    *state = TypeLayFcitxQtStateV1{};
+    state->contextGeneration = context.generation;
+    state->fieldGeneration = field.generation;
+    state->epoch = tlEpoch_;
+    state->inputEpoch = field.inputEpoch;
+    state->serverSerial = serial;
+    state->appliedSerial = proxy->typelayAppliedSerial();
+    state->flags = (known ? TlQtKnown : 0u) | (focused ? TlQtFocused : 0u) |
+        ((pending || tlPendingDbus || tlPendingForward || tlOutputDepth ||
+          serial != state->appliedSerial) ? TlQtPending : 0u) |
+        ((composing || !preeditList_.isEmpty() || !commitPreedit_.isEmpty() ||
+          (xkbComposeState_ && xkb_compose_state_get_status(xkbComposeState_.data()) ==
+           XKB_COMPOSE_COMPOSING)) ? TlQtComposing : 0u);
+    tlProofObject_.clear();
+    if (state->flags == (TlQtKnown | TlQtFocused) && tlLocalClear(actual)) {
+        tlProof_ = *state;
+        tlProofQueueEpoch_ = tlQueueEpoch;
+        tlProofObject_ = actual;
+    }
+    return true;
+}
+
+bool QFcitxPlatformInputContext::validateLocal(QObject *actual, const TypeLayFcitxQtStateV1 *state) {
+    if (state && state->size == sizeof(*state) && state->version == 1 &&
+        state->flags == (TlQtKnown | TlQtDetached)) {
+        const auto &proof = tlDetached_.state;
+        return tlDetached_.inspected && tlDetachedValid(actual) &&
+            state->contextGeneration == proof.contextGeneration &&
+            state->fieldGeneration == proof.fieldGeneration &&
+            state->epoch == proof.epoch && state->inputEpoch == proof.inputEpoch &&
+            state->serverSerial == proof.serverSerial && state->appliedSerial == proof.appliedSerial;
+    }
+    if (!state || state->size != sizeof(*state) || state->version != 1 ||
+        state->flags != (TlQtKnown | TlQtFocused) || actual != tlProofObject_ ||
+        tlInspecting_ || !tlLocalClear(actual) || tlProofQueueEpoch_ != tlQueueEpoch ||
+        state->epoch != tlEpoch_ || state->epoch != tlProof_.epoch ||
+        state->contextGeneration != tlProof_.contextGeneration ||
+        state->fieldGeneration != tlProof_.fieldGeneration ||
+        state->inputEpoch != tlFields_.value(actual).inputEpoch ||
+        state->serverSerial != tlProof_.serverSerial ||
+        state->appliedSerial != tlProof_.appliedSerial) return false;
+    auto *hybrid = validICByWindow(lastWindow_);
+    auto *proxy = hybrid ? hybrid->typelayProxy() : nullptr;
+    return proxy && proxy == tlContexts_.value(hybrid).proxy &&
+        proxy->isValid() && !proxy->typelayOutputDepth() &&
+        proxy->typelayGeneration() == tlContexts_.value(hybrid).remoteGeneration &&
+        proxy->typelayAppliedSerial() == state->appliedSerial;
+}
+
+bool QFcitxPlatformInputContext::prepareCaret(QObject *actual, const TypeLayFcitxQtStateV1 *state) {
+    if (!validateLocal(actual, state)) return false;
+    // An already detached field has no active IM to prepare. Never reset B's IC.
+    if (state->flags == (TlQtKnown | TlQtDetached)) return true;
+    auto *hybrid = validICByWindow(lastWindow_);
+    auto *proxy = hybrid ? hybrid->typelayProxy() : nullptr;
+    if (!proxy) return false;
+    // Caller must freshly inspect and revalidate source/focus after this output batch.
+    tlProofObject_.clear();
+    return proxy->typelayPrepareCaret(state->serverSerial);
+}
+
+bool QFcitxPlatformInputContext::supportsControlKeys(QObject *actual, quint32 accept, quint32 exit) const {
+    if (!tlCooperate() || syncMode_ || destroy_ || !actual || QThread::currentThread() != thread() ||
+        actual->property(TypeLayFcitxQtProviderPropertyV1).value<QObject *>() != this) return false;
+    const auto keys = qApp->property(TypeLayFcitxQtControlKeysPropertyV1).toList();
+    const auto available = [&](quint32 symbol) {
+        if (!symbol) return false;
+        for (const auto &key : keys)
+            if (key.metaType() == QMetaType::fromType<uint>() && key.toUInt() == symbol) return true;
+        return false;
+    };
+    return accept != exit && available(accept) && available(exit);
+}
+
+bool QFcitxPlatformInputContext::supportsOrderedKeys(QObject *actual, quint32 accept, quint32 exit) const {
+    if (!tlCooperate() || syncMode_ || destroy_ || !actual || (!accept && !exit) ||
+        QThread::currentThread() != thread() ||
+        actual->property(TypeLayFcitxQtProviderPropertyV1).value<QObject *>() != this) return false;
+    const auto keys = qApp->property(TypeLayFcitxQtOrderedKeysPropertyV1).toList();
+    const auto installed = [&](quint32 symbol) {
+        if (!symbol) return true; // This action is plain, not an ordered route.
+        if (symbol < 0xffbeu || symbol > 0xffd5u) return false;
+        for (const auto &key : keys)
+            if (key.metaType() == QMetaType::fromType<uint>() && key.toUInt() == symbol) return true;
+        return false;
+    };
+    return installed(accept) && installed(exit);
+}
+
+bool QFcitxPlatformInputContext::supportsEditorOrderedKeys(QObject *actual, quint32 accept, quint32 exit) const {
+    return supportsOrderedKeys(actual, accept, exit);
+}
+
+void QFcitxPlatformInputContext::tlReleaseControlGroup(const QKeyEvent *key) {
+    if (key->type() != QEvent::KeyRelease || key->isAutoRepeat()) return;
+    if (key->nativeScanCode() == tlClaimedCtrlScan_) tlClaimedCtrlScan_ = 0;
+    if (key->nativeScanCode() == tlClaimedFnScan_) tlClaimedFnScan_ = 0;
+}
+
+void QFcitxPlatformInputContext::tlDeadline(qint64 until) {
+    tlOrdered_.until = until;
+    tlOrderedDeadline_.start(int(std::clamp<qint64>(until - tlNow(), 0, 150)));
+}
+
+void QFcitxPlatformInputContext::cancelOrdered(quint64 ticket) {
+    if (!ticket || ticket != tlOrdered_.id || tlOrdered_.cancelled) return;
+    tlOrdered_.cancelled = true;
+    tlOrderedDeadline_.stop();
+    tlSchedule(); // Permission is gone now; original events are not discarded.
+}
+
+void QFcitxPlatformInputContext::tlRetireOrdered() {
+    const auto previous = tlOrdered_;
+    tlOrdered_ = {};
+    tlOrderedDeadline_.stop();
+    if (previous.consumer) {
+        auto *control = qobject_cast<TypeLayFcitxQtOrderedControlV1 *>(previous.consumer.data());
+        if (control) control->retireOrdered(previous.id);
+    }
+}
+
+bool QFcitxPlatformInputContext::validateOrdered(QObject *actual, quint64 ticket,
+    const TypeLayFcitxQtStateV1 *before, const TypeLayFcitxQtStateV1 *current) {
+    const auto &saved = tlOrdered_.before;
+    return before && current && ticket && ticket == tlOrdered_.id && tlOrdered_.deciding &&
+        !tlOrdered_.cancelled && actual == tlOrdered_.actual && tlNow() < tlOrdered_.until &&
+        tlOrdered_.consumer && qApp->property(TypeLayFcitxQtConsumerPropertyV1).value<QObject *>() == tlOrdered_.consumer &&
+        before->size == sizeof(*before) && before->version == 1 &&
+        before->contextGeneration == saved.contextGeneration && before->fieldGeneration == saved.fieldGeneration &&
+        before->epoch == saved.epoch && before->inputEpoch == saved.inputEpoch &&
+        before->serverSerial == saved.serverSerial && before->appliedSerial == saved.appliedSerial &&
+        before->flags == saved.flags && current->epoch == tlOrdered_.epoch &&
+        current->contextGeneration == saved.contextGeneration && current->fieldGeneration == saved.fieldGeneration &&
+        current->inputEpoch == saved.inputEpoch && current->serverSerial == saved.serverSerial &&
+        current->appliedSerial == saved.appliedSerial && validateLocal(actual, current);
+}
+
+bool QFcitxPlatformInputContext::claimOrdered(QObject *actual, quint64 ticket,
+    const TypeLayFcitxQtStateV1 *before, const TypeLayFcitxQtStateV1 *current) {
+    if (!validateOrdered(actual, ticket, before, current) || tlOrdered_.claimed) return false;
+    tlOrdered_.claimed = true;
+    if (tlDecision_) tlDecision_->claimed = true;
+    tlHeldControlKeys_.insert(tlOrdered_.scan, true);
+    tlClaimedCtrlScan_ = tlOrdered_.ctrlScan;
+    tlClaimedFnScan_ = tlOrdered_.scan;
+    return true;
+}
+
+bool QFcitxPlatformInputContext::tlOrderedKey(const QKeyEvent *key) {
+    if (tlOrderedDraining_ || syncMode_ || destroy_) return false;
+    if (tlOrdered_.deciding) {
+        if (key->nativeScanCode() != tlOrdered_.scan) { cancelOrdered(tlOrdered_.id); return false; }
+        // One additional original (the deciding Fn) lives on the caller stack.
+        if (tlDeferred_.size() < 63) {
+            tlDeferred_.push_back({tlCopyKey(*key), focusWindowWrapper()});
+            return true;
+        }
+        cancelOrdered(tlOrdered_.id);
+        if (!tlOrdered_.claimed) return false; // claim now cannot succeed.
+        if (key->type() == QEvent::KeyRelease && !key->isAutoRepeat()) tlOrdered_.releasedDuringDecision = true;
+        return true; // Already consumed; no additional event copy is necessary.
+    }
+    const bool down = key->type() == QEvent::KeyPress && !key->isAutoRepeat();
+    const auto scan = key->nativeScanCode();
+    QPointer<QFcitxPlatformInputContext> alive(this);
+    if (tlOrdered_.id) {
+        if (tlNow() >= tlOrdered_.until) cancelOrdered(tlOrdered_.id);
+        if (tlOrdered_.cancelled) {
+            tlPassDeferred();
+            return false;
+        }
+        if (!tlDeferred_.empty()) {
+            if (tlDeferred_.size() >= 64) {
+                cancelOrdered(tlOrdered_.id);
+                // Keep the triggering original on its native stack. Reentrant
+                // application input follows upstream semantics, not a new FIFO.
+                tlPassDeferred();
+                return false;
+            }
+            tlDeferred_.push_back({tlCopyKey(*key), focusWindowWrapper()});
+            return true; // Transport ownership only, not a TypeLay consumption.
+        }
+        const auto &grant = tlOrdered_.grant;
+        const quint32 symbol = key->nativeVirtualKey();
+        const qint64 until = symbol == grant.accept ? grant.acceptUntil
+            : symbol == grant.exit ? grant.exitUntil : 0;
+        if (down && scan && key->modifiers() == Qt::ControlModifier && until > tlNow() &&
+            key->key() >= Qt::Key_F1 && key->key() <= Qt::Key_F24 &&
+            !tlHeldControlKeys_.contains(scan) && tlHeldControlKeys_.size() < 64 &&
+            supportsOrderedKeys(tlOrdered_.actual, symbol, 0u)) {
+            tlOrdered_.scan = scan;
+            tlHeldControlKeys_.insert(scan, false);
+            tlDeferred_.push_back({tlCopyKey(*key), focusWindowWrapper()});
+            tlDeadline(until); // The selected original deadline, never now + lease.
+            tlSchedule();
+            return true;
+        }
+        cancelOrdered(tlOrdered_.id);
+        tlPassDeferred();
+        return false;
+    }
+    if (!down || !scan || key->key() != Qt::Key_Control ||
+        (key->modifiers() & ~Qt::ControlModifier) || tlPendingDbus || tlPendingForward || tlOutputDepth ||
+        tlClaimedCtrlScan_ || tlClaimedFnScan_ || !tlHeldControlKeys_.isEmpty())
+        return false;
+    QPointer<QObject> actual(focusObjectWrapper());
+    QPointer<QObject> consumer(qApp->property(TypeLayFcitxQtConsumerPropertyV1).value<QObject *>());
+    auto *control = consumer ? qobject_cast<TypeLayFcitxQtOrderedControlV1 *>(consumer.data()) : nullptr;
+    if (!control || !actual || actual != tlBound_ ||
+        qApp->property(TypeLayFcitxQtOrderedKeysPropertyV1).toList().isEmpty()) return false;
+    TypeLayFcitxQtStateV1 before;
+    if (!inspect(actual, &before) || !alive || !actual || !consumer || !validateLocal(actual, &before)) return false;
+    const auto id = ++tlNextTicket_;
+    tlOrdered_.id = id; // Reserve before the consumer can reenter/revoke.
+    tlOrdered_.actual = actual;
+    tlOrdered_.consumer = consumer;
+    tlOrdered_.before = before;
+    tlOrdered_.epoch = before.epoch;
+    tlOrdered_.ctrlScan = scan;
+    tlOrdered_.ctrlTimestamp = key->timestamp();
+    TypeLayFcitxQtOrderedGrantV1 grant;
+    const bool accepted = control->beginOrdered(actual, id, key, &before, &grant);
+    if (!alive) return false;
+    if (!accepted || !actual || !consumer || tlOrdered_.id != id || tlOrdered_.cancelled ||
+        actual != tlBound_ || !validateLocal(actual, &before) ||
+        !supportsOrderedKeys(actual, grant.acceptUntil ? grant.accept : 0u, grant.exitUntil ? grant.exit : 0u)) {
+        cancelOrdered(id);
+        tlRetireOrdered();
+        return false;
+    }
+    tlOrdered_.grant = grant;
+    tlDeadline(std::max(grant.acceptUntil, grant.exitUntil));
+    return false; // Original Ctrl is always handled by the original provider.
+}
+
+void QFcitxPlatformInputContext::tlPassDeferred() {
+    if (tlOrderedDraining_ || tlOrdered_.deciding) return;
+    tlOrderedDraining_ = true;
+    QPointer<QFcitxPlatformInputContext> alive(this);
+    tlRetireOrdered();
+    if (!alive) return;
+    while (!tlDeferred_.empty()) {
+        auto item = std::move(tlDeferred_.front());
+        tlDeferred_.pop_front();
+        const auto &key = *item.event;
+        tlReleaseControlGroup(&key);
+        if (key.type() == QEvent::KeyPress && !tlHeldControlKeys_.contains(key.nativeScanCode())
+            && tlHeldControlKeys_.size() < 64 && (key.key() == Qt::Key_Tab || key.key() == Qt::Key_Escape
+                || (key.key() >= Qt::Key_F1 && key.key() <= Qt::Key_F24)))
+            tlHeldControlKeys_.insert(key.nativeScanCode(), false);
+        const auto held = tlHeldControlKeys_.constFind(key.nativeScanCode());
+        const bool consumed = held != tlHeldControlKeys_.cend() && *held;
+        if (key.type() == QEvent::KeyRelease && !key.isAutoRepeat()) tlHeldControlKeys_.remove(key.nativeScanCode());
+        if (consumed || !item.window) continue;
+        // No recursive public filter: preserve upstream IM queries and fallback.
+        // Their application reentry retains normal Qt semantics after revocation.
+        const bool filtered = tlOriginalFilter(item.event.get());
+        if (!alive) return;
+        if (!filtered && item.window) forwardEvent(item.window, key);
+        if (!alive) return;
+    }
+    tlOrderedDraining_ = false;
+}
+
+void QFcitxPlatformInputContext::tlAdvanceOrdered() {
+    if (!tlOrdered_.id || tlOrderedDraining_ || tlOrdered_.deciding || destroy_) return;
+    if (tlNow() >= tlOrdered_.until) cancelOrdered(tlOrdered_.id);
+    if (tlOrdered_.cancelled) { tlPassDeferred(); return; }
+    if (tlDeferred_.empty() || tlPendingDbus || tlPendingForward || tlOutputDepth || !tlKeyQueue_.empty()) return;
+    const auto id = tlOrdered_.id;
+    QPointer<QFcitxPlatformInputContext> alive(this);
+    QPointer<QObject> actual = tlOrdered_.actual, consumer = tlOrdered_.consumer;
+    auto *control = consumer ? qobject_cast<TypeLayFcitxQtOrderedControlV1 *>(consumer.data()) : nullptr;
+    TypeLayFcitxQtStateV1 current;
+    if (!control || !actual || !inspect(actual, &current)) {
+        if (alive) { cancelOrdered(id); tlPassDeferred(); }
+        return;
+    }
+    if (!alive) return;
+    tlOrdered_.deciding = true;
+    if (!validateOrdered(actual, id, &tlOrdered_.before, &current)) {
+        tlOrdered_.deciding = false;
+        cancelOrdered(id); tlPassDeferred(); return;
+    }
+    // Keep the Fn node alive across callbacks; the queue is not drained/replaced
+    // while deciding. A reentrant revoke may reject, but cannot replay this Fn.
+    const auto scan = tlOrdered_.scan;
+    auto decision = std::make_shared<TlDecision>();
+    decision->original = std::move(tlDeferred_.front());
+    tlDeferred_.pop_front();
+    tlDecision_ = decision;
+    const bool consumed = control->decideOrdered(actual, id, decision->original.event.get(), &current);
+    if (!alive) return; // Destructor handed off unclaimed originals exactly once.
+    tlDecision_.reset();
+    tlOrdered_.deciding = false;
+    const bool owned = consumed || decision->claimed;
+    const bool released = tlOrdered_.releasedDuringDecision;
+    if (owned) tlHeldControlKeys_.insert(scan, true);
+    else tlDeferred_.push_front(std::move(decision->original));
+    tlOrdered_.cancelled = true;
+    tlPassDeferred();
+    if (alive && released) tlHeldControlKeys_.remove(scan);
+}
+
+bool QFcitxPlatformInputContext::tlControlKey(const QKeyEvent *event) {
+    const bool release = event->type() == QEvent::KeyRelease;
+    bool traceCandidate = event->key() == Qt::Key_Tab || event->key() == Qt::Key_Escape;
+    for (const auto &key : qApp->property(TypeLayFcitxQtControlKeysPropertyV1).toList())
+        traceCandidate = traceCandidate || (key.metaType() == QMetaType::fromType<uint>() &&
