+// Observe actual replay delivery, which bypasses the original IM filter. A key
+// requested by field A may be delivered to field B after a same-window switch.
+bool QFcitxPlatformInputContext::eventFilter(QObject *object, QEvent *event) {
+    if (object && object == tlDetached_.source) {
+        if (event->type() == QEvent::KeyPress || event->type() == QEvent::KeyRelease ||
+            event->type() == QEvent::InputMethod) tlRevokeDetached(TlQtInput);
+        else if (event->type() == QEvent::FocusIn || event->type() == QEvent::ParentChange)
+            tlRevokeDetached(TlQtFocus);
+    }
+    if (tlCooperate() && tlPendingForward && object == tlBound_ &&
+        (event->type() == QEvent::KeyPress || event->type() == QEvent::KeyRelease)) {
+        const auto *key = static_cast<QKeyEvent *>(event);
+        const bool prefix = tlOrdered_.id && !tlOrdered_.cancelled && tlOrdered_.submitted
+            && !tlOrdered_.replayed && event->type() == QEvent::KeyPress
+            && key->key() == Qt::Key_Control && key->nativeScanCode() == tlOrdered_.ctrlScan
+            && key->timestamp() == tlOrdered_.ctrlTimestamp;
+        if (prefix) tlOrdered_.replayed = true;
+        tlChanged(tlKeyCause(key->key()) | (prefix ? TlQtOrderedPrefix : 0u));
+    }
+    return QPlatformInputContext::eventFilter(object, event);
+}
