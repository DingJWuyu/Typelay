+    if (tlHeldControlKeys_.size() >= 64) return false;
+    tlHeldControlKeys_.insert(scan, false);
+    if (tlControl_) { trace("precheck", 0); return false; }
+    bool candidate = event->modifiers() == Qt::NoModifier &&
+        (event->key() == Qt::Key_Tab || event->key() == Qt::Key_Escape);
+    for (const auto &key : qApp->property(TypeLayFcitxQtControlKeysPropertyV1).toList()) {
+        if (key.metaType() == QMetaType::fromType<uint>() &&
+            key.toUInt() == event->nativeVirtualKey()) candidate = true;
+    }
+    if (!candidate) { trace("not-candidate", 0); return false; }
