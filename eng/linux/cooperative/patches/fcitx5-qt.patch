+void QFcitxPlatformInputContext::tlRevokeDetached(quint32 causes) {
+    QPointer<QObject> source = tlDetached_.source;
+    tlDetached_ = {};
+    if (!source) return;
+    if (source != tlBound_ &&
+        source->property(TypeLayFcitxQtProviderPropertyV1).value<QObject *>() == this)
+        source->setProperty(TypeLayFcitxQtProviderPropertyV1, QVariant());
+    if ((causes & TlQtInput) && tlFields_.contains(source)) ++tlFields_[source].inputEpoch;
+    Q_EMIT typelayStateChangedV1(source, causes);
+}
