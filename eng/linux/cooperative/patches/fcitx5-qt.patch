+    tlControl_ = true;
+    trace("consumer-call", -1);
+    const bool consumed = control->filterControlKey(actual, const_cast<QKeyEvent *>(event));
+    if (!self) return consumed;
+    tlControl_ = false;
+    trace("consumer-result", int(consumed));
+    if (consumed && tlHeldControlKeys_.contains(scan)) tlHeldControlKeys_.insert(scan, true);
+    return consumed;
+}
