+    QPointer<QObject> consumer(qApp->property(TypeLayFcitxQtConsumerPropertyV1).value<QObject *>());
+    auto *control = consumer ? qobject_cast<TypeLayFcitxQtControlV1 *>(consumer.data()) : nullptr;
+    if (!actual || actual != tlBound_ || !control) { trace("binding", 0); return false; }
