+static guint typelay_focus_flags(FcitxIMContext *self, GtkWidget *widget) {
+    if (self->has_focus) return TL_FCITX_FOCUSED;
+    if (!widget || G_OBJECT_TYPE(widget) != GTK_TYPE_ENTRY || gtk_widget_has_focus(widget)) return 0;
+    GtkWidget *top = gtk_widget_get_toplevel(widget);
+    if (!GTK_IS_WINDOW(top) || !gtk_window_is_active(GTK_WINDOW(top))) return 0;
+    GtkWidget *focused = gtk_window_get_focus(GTK_WINDOW(top));
+    return focused && focused != widget ? TL_FCITX_DETACHED : 0;
+}
