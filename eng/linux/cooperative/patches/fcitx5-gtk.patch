+/* TypeLay feasibility extension. Unknown/missing RPC always fails closed. */
+gboolean fcitx_g_client_typelay_probe_state_v1(FcitxGClient *self,
+    guint64 *server_serial, guint64 *delivered, gboolean *known,
+    gboolean *pending, gboolean *composing, gboolean *focused, GError **error) {
+    if (!fcitx_g_client_is_valid(self)) return FALSE;
+    GVariant *reply = g_dbus_proxy_call_sync(self->priv->icproxy,
+        "TypeLayProbeStateV1", NULL, G_DBUS_CALL_FLAGS_NONE, 25, NULL, error);
+    if (!reply) return FALSE;
+    if (!g_variant_is_of_type(reply, G_VARIANT_TYPE("(tbbbb)"))) {
+        g_variant_unref(reply);
+        return FALSE;
+    }
+    g_variant_get(reply, "(tbbbb)", server_serial, known, pending, composing, focused);
+    *delivered = self->priv->typelayDelivered;
+    g_variant_unref(reply);
+    return TRUE;
+}
+
+gboolean fcitx_g_client_typelay_deferred_switch_fixture_v1(FcitxGClient *self) {
+    if (!fcitx_g_client_is_valid(self)) return FALSE;
+    GError *error = NULL;
+    GVariant *reply = g_dbus_proxy_call_sync(self->priv->icproxy,
+        "TypeLayDeferredSwitchFixtureV1", NULL, G_DBUS_CALL_FLAGS_NONE, 1000, NULL, &error);
+    g_clear_error(&error);
+    if (!reply) return FALSE;
+    gboolean result = FALSE;
+    if (g_variant_is_of_type(reply, G_VARIANT_TYPE("(b)"))) g_variant_get(reply, "(b)", &result);
+    g_variant_unref(reply);
+    return result;
+}
+
+guint64 fcitx_g_client_typelay_delivered_v1(FcitxGClient *self) {
+    return self->priv->typelayDelivered;
+}
+
+gboolean fcitx_g_client_typelay_prepare_caret_v1(FcitxGClient *self, guint64 expected) {
+    if (!fcitx_g_client_is_valid(self)) return FALSE;
+    GError *error = NULL;
+    GVariant *reply = g_dbus_proxy_call_sync(self->priv->icproxy,
+        "TypeLayPrepareCaretV1", g_variant_new("(t)", expected),
+        G_DBUS_CALL_FLAGS_NONE, 25, NULL, &error);
+    if (!reply) {
+        if (g_getenv("TYPELAY_TRACE")) g_printerr("typelay-fcitx-prepare rpc-failed\n");
+        g_clear_error(&error);
+        return FALSE;
+    }
+    gboolean result = FALSE;
+    if (g_variant_is_of_type(reply, G_VARIANT_TYPE("(a(uv)b)")))
+        result = _fcitx_g_client_handle_process_key_reply(self, reply);
+    g_variant_unref(reply);
+    return result;
+}
