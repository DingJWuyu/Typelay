+    }
+    if (localCompositionMask) composing = TRUE;
+    *state = {sizeof(*state), TL_FCITX_ABI_V1, self->typelay_generation,
+        self->typelay_epoch, self->typelay_input_epoch, serial, applied,
+        static_cast<guint32>((known ? TL_FCITX_KNOWN : 0) | focus_flags
+            | (pending ? TL_FCITX_PENDING : 0) | (composing ? TL_FCITX_COMPOSING : 0))};
+    if (focus_flags == TL_FCITX_DETACHED &&
+        (state->flags != (TL_FCITX_KNOWN | TL_FCITX_DETACHED) || serial != applied))
+        return refuse("detached-state");
+    if (state->flags == (TL_FCITX_KNOWN | focus_flags) && serial == applied) {
+        self->typelay_proof = *state;
+        self->typelay_proof_valid = TRUE;
+    }
+    return TRUE;
+}
+
+static gboolean typelay_validate_local(GtkIMContext *context, GtkWidget *widget,
+                                       const TlFcitxStateV1 *baseline) {
+    auto refuse = [](const char *reason) -> gboolean {
+        if (g_getenv("TYPELAY_TRACE")) g_printerr("typelay-fcitx-local %s\n", reason);
+        return FALSE;
+    };
+    if (!baseline || baseline->size != sizeof(*baseline) || baseline->version != TL_FCITX_ABI_V1)
+        return refuse("abi");
+    if (!FCITX_IS_IM_CONTEXT(context)) return refuse("context");
+    if (!get_boolean_env("TYPELAY_FCITX_COOPERATIVE", FALSE)) return refuse("disabled");
+    if (g_main_depth() != 1) return refuse("main-depth");
+    auto *self = FCITX_IM_CONTEXT(context);
+    if (self->client_widget != widget || !widget ||
+        g_object_get_data(G_OBJECT(widget), TL_FCITX_CONTEXT_V1) != context) return refuse("owner");
+    const guint focus_flags = typelay_focus_flags(self, widget);
+    if (!focus_flags) return refuse("focus");
+    if (self->typelay_depth) return refuse("callback-depth");
+    if (!_use_sync_mode) return refuse("dispatch-mode");
+    if (g_hash_table_size(self->pending_events)) return refuse("pending-events");
+    if (!fcitx_g_client_is_valid(self->client)) return refuse("client");
+    if (baseline->context_generation != self->typelay_generation) return refuse("generation");
+    if (baseline->input_epoch != self->typelay_input_epoch) return refuse("input");
+    if (baseline->epoch != self->typelay_epoch) return refuse("epoch");
+    if (baseline->applied_serial != fcitx_g_client_typelay_delivered_v1(self->client)) return refuse("applied");
+    if (self->is_inpreedit || self->typelay_slave_composing || (self->preedit_string && *self->preedit_string)
+        || (self->xkbComposeState && xkb_compose_state_get_status(self->xkbComposeState) != XKB_COMPOSE_NOTHING))
+        return refuse("composition");
+    const auto &proof = self->typelay_proof;
+    if (!self->typelay_proof_valid || baseline->flags != (TL_FCITX_KNOWN | focus_flags)
+        || baseline->server_serial != baseline->applied_serial
+        || proof.size != baseline->size || proof.version != baseline->version
+        || proof.context_generation != baseline->context_generation || proof.epoch != baseline->epoch
+        || proof.input_epoch != baseline->input_epoch || proof.server_serial != baseline->server_serial
+        || proof.applied_serial != baseline->applied_serial || proof.flags != baseline->flags)
+        return refuse("baseline");
+    return TRUE;
+}
+
+static gboolean typelay_prepare_caret(GtkIMContext *context, GtkWidget *widget,
+                                      const TlFcitxStateV1 *baseline) {
+    if (!widget || !typelay_validate_local(context, widget, baseline)) return FALSE;
+    const gboolean text_view = G_OBJECT_TYPE(widget) == GTK_TYPE_TEXT_VIEW;
+    GtkWidget *entry = nullptr;
+    if (!text_view) {
+        if (G_OBJECT_TYPE(widget) != GTK_TYPE_TEXT) return FALSE;
+        entry = gtk_widget_get_parent(widget);
+        if (!entry || G_OBJECT_TYPE(entry) != GTK_TYPE_ENTRY ||
+            gtk_editable_get_delegate(GTK_EDITABLE(entry)) != GTK_EDITABLE(widget)) return FALSE;
+    }
+    auto *self = FCITX_IM_CONTEXT(context);
+    if (self->typelay_preparing || self->ignore_reset) return FALSE;
+    self->typelay_preparing = TRUE;
+    self->typelay_prepare_ok = TRUE;
+    self->typelay_prepare_serial = baseline->server_serial;
+    if (text_view) gtk_text_view_reset_im_context(GTK_TEXT_VIEW(widget));
+    else gtk_entry_reset_im_context(GTK_ENTRY(entry));
+    self->typelay_preparing = FALSE;
+    return self->typelay_prepare_ok;
+}
+
+static gboolean typelay_prefix_supports(GtkIMContext *context, GtkWidget *widget) {
+    if (!FCITX_IS_IM_CONTEXT(context) || !widget
+        || !get_boolean_env("TYPELAY_FCITX_COOPERATIVE", FALSE) || !_use_sync_mode
+        || g_main_depth() != 1) return FALSE;
+    GtkWidget *entry = G_OBJECT_TYPE(widget) == GTK_TYPE_TEXT ? gtk_widget_get_parent(widget) : nullptr;
+    const gboolean standard_entry = entry && G_OBJECT_TYPE(entry) == GTK_TYPE_ENTRY
+        && gtk_editable_get_delegate(GTK_EDITABLE(entry)) == GTK_EDITABLE(widget)
+        && G_OBJECT_TYPE(gtk_entry_get_buffer(GTK_ENTRY(entry))) == GTK_TYPE_ENTRY_BUFFER;
+    const gboolean text_view = G_OBJECT_TYPE(widget) == GTK_TYPE_TEXT_VIEW
+        && G_OBJECT_TYPE(gtk_text_view_get_buffer(GTK_TEXT_VIEW(widget))) == GTK_TYPE_TEXT_BUFFER;
+    auto *self = FCITX_IM_CONTEXT(context);
+    return (standard_entry || text_view) && self->client_widget == widget
+        && g_object_get_data(G_OBJECT(widget), TL_FCITX_CONTEXT_V1) == context;
+}
+static gboolean typelay_prefix_equal(const TlFcitxStateV1 *a, const TlFcitxStateV1 *b) {
+    return a && b && a->size == b->size && a->version == b->version
+        && a->context_generation == b->context_generation && a->epoch == b->epoch
+        && a->input_epoch == b->input_epoch && a->server_serial == b->server_serial
+        && a->applied_serial == b->applied_serial && a->flags == b->flags;
+}
+static gboolean typelay_prefix_begin(GtkIMContext *context, GtkWidget *widget, guint64 id,
+    const GdkEvent *event, const TlFcitxStateV1 *before) {
+    GdkDevice *device = event ? gdk_event_get_device(const_cast<GdkEvent *>(event)) : nullptr;
+    if (!id || !event || gdk_event_get_event_type(const_cast<GdkEvent *>(event)) != GDK_KEY_PRESS
+        || !device || gdk_device_get_source(device) != GDK_SOURCE_KEYBOARD
+        || !gdk_key_event_get_keycode(const_cast<GdkEvent *>(event))
+        || (gdk_key_event_get_keyval(const_cast<GdkEvent *>(event)) != GDK_KEY_Control_L
+            && gdk_key_event_get_keyval(const_cast<GdkEvent *>(event)) != GDK_KEY_Control_R)
+        || !typelay_prefix_supports(context, widget)
+        || !before || before->flags != (TL_FCITX_KNOWN | TL_FCITX_FOCUSED)
+        || !typelay_validate_local(context, widget, before)) return FALSE;
+    // Toolkits may include Control itself on its original down. Other shortcut
+    // modifiers are excluded, and submission still matches this exact state.
+    const guint modifiers = GDK_SHIFT_MASK | GDK_ALT_MASK | GDK_SUPER_MASK | GDK_HYPER_MASK | GDK_META_MASK;
+    if (gdk_event_get_modifier_state(const_cast<GdkEvent *>(event)) & modifiers) return FALSE;
+    auto *self = FCITX_IM_CONTEXT(context);
+    if (self->typelay_prefix_id || self->typelay_preparing) return FALSE;
+    self->typelay_prefix_before = *before;
+    self->typelay_prefix_epoch = before->epoch;
+    self->typelay_prefix_key = gdk_key_event_get_keyval(const_cast<GdkEvent *>(event));
+    self->typelay_prefix_code = gdk_key_event_get_keycode(const_cast<GdkEvent *>(event));
+    self->typelay_prefix_time = gdk_event_get_time(const_cast<GdkEvent *>(event));
+    self->typelay_prefix_state = gdk_event_get_modifier_state(const_cast<GdkEvent *>(event));
+    self->typelay_prefix_surface = gdk_event_get_surface(const_cast<GdkEvent *>(event));
+    self->typelay_prefix_device = device;
+    self->typelay_prefix_replied = self->typelay_prefix_submitted = self->typelay_prefix_completed = self->typelay_prefix_finished = FALSE;
+    self->typelay_prefix_prepared = self->typelay_prefix_reset = self->typelay_prefix_notifying = FALSE;
+    self->typelay_prefix_prepare_owner = 0;
+    self->typelay_prefix_id = id;
+    return TRUE;
+}
+static gboolean typelay_prefix_transition(GtkIMContext *context, guint64 id) {
+    return FCITX_IS_IM_CONTEXT(context) && id && FCITX_IM_CONTEXT(context)->typelay_prefix_id == id
+        && FCITX_IM_CONTEXT(context)->typelay_prefix_notifying;
+}
+static gboolean typelay_prefix_validate(GtkIMContext *context, GtkWidget *widget, guint64 id,
+    const TlFcitxStateV1 *before, const TlFcitxStateV1 *current) {
+    if (!typelay_prefix_supports(context, widget)) return FALSE;
+    auto *self = FCITX_IM_CONTEXT(context);
+    if (!id || self->typelay_prefix_id != id || !self->typelay_prefix_finished
+        || !typelay_prefix_equal(before, &self->typelay_prefix_before) || !current) return FALSE;
+    auto expected = *before;
+    expected.epoch = self->typelay_prefix_epoch;
+    return typelay_prefix_equal(&expected, current) && typelay_validate_local(context, widget, current);
+}
+static gboolean typelay_prefix_finish(GtkIMContext *context, GtkWidget *widget, guint64 id,
+    TlFcitxStateV1 *current) {
+    if (!typelay_prefix_supports(context, widget)) return FALSE;
+    auto *self = FCITX_IM_CONTEXT(context);
+    if (!id || self->typelay_prefix_id != id || !self->typelay_prefix_completed
+        || self->typelay_prefix_finished) return FALSE;
+    if (!typelay_inspect(context, widget, current) || self->typelay_prefix_id != id) return FALSE;
+    self->typelay_prefix_finished = TRUE;
+    if (typelay_prefix_validate(context, widget, id, &self->typelay_prefix_before, current)) return TRUE;
+    self->typelay_prefix_id = 0;
+    return FALSE;
+}
+static gboolean typelay_prefix_prepare(GtkIMContext *context, GtkWidget *widget, guint64 id,
+    const TlFcitxStateV1 *current) {
+    if (!FCITX_IS_IM_CONTEXT(context)) return FALSE;
+    auto *self = FCITX_IM_CONTEXT(context);
+    if (self->typelay_prefix_prepared || !typelay_prefix_validate(context, widget, id,
+        &self->typelay_prefix_before, current)) return FALSE;
+    self->typelay_prefix_prepared = TRUE;
+    self->typelay_prefix_prepare_owner = id;
+    const gboolean ready = typelay_prepare_caret(context, widget, current);
+    self->typelay_prefix_prepare_owner = 0;
+    return ready && self->typelay_prefix_id == id;
+}
+static void typelay_prefix_cancel(GtkIMContext *context, guint64 id) {
+    if (FCITX_IS_IM_CONTEXT(context) && id && FCITX_IM_CONTEXT(context)->typelay_prefix_id == id)
+        FCITX_IM_CONTEXT(context)->typelay_prefix_id = 0;
+}
