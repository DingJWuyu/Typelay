+static guint typelay_focus_flags(FcitxIMContext *self, GtkWidget *widget) {
+    if (self->has_focus) return TL_FCITX_FOCUSED;
+    if (!widget || G_OBJECT_TYPE(widget) != GTK_TYPE_TEXT || gtk_widget_has_focus(widget)) return 0;
+    GtkWidget *entry = gtk_widget_get_parent(widget);
