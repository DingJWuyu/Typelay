+// TypeLay 2026-10-13: pure modifiers still revoke the local proof/epoch.
+// Actual engine/preedit/commit callbacks independently retain their Input cause.
+static guint typelay_key_cause(guint keyval) {
+    switch (keyval) {
+    case GDK_KEY_Shift_L: case GDK_KEY_Shift_R:
+    case GDK_KEY_Control_L: case GDK_KEY_Control_R:
+    case GDK_KEY_Alt_L: case GDK_KEY_Alt_R:
+    case GDK_KEY_Meta_L: case GDK_KEY_Meta_R:
+    case GDK_KEY_ISO_Level3_Shift:
+        return 0;
+    default:
+        return TL_FCITX_CHANGE_INPUT;
+    }
+}
+
+static void typelay_changed(FcitxIMContext *context, guint causes, gboolean prefix = FALSE) {
+    if (!get_boolean_env("TYPELAY_FCITX_COOPERATIVE", FALSE)) return;
+    if (!prefix || !context->typelay_prefix_id || causes || context->typelay_epoch == G_MAXUINT64)
+        context->typelay_prefix_id = 0;
+    context->typelay_proof_valid = FALSE;
+    ++context->typelay_epoch;
+    if (context->typelay_prefix_id) context->typelay_prefix_epoch = context->typelay_epoch;
+    if (causes & TL_FCITX_CHANGE_INPUT) ++context->typelay_input_epoch;
+    if (causes & TL_FCITX_CHANGE_BINDING) context->typelay_generation = ++typelay_next_generation;
+    TypeLayCallback callback(context);
+    context->typelay_prefix_notifying = prefix && context->typelay_prefix_id;
+    g_signal_emit(context, typelay_changed_signal, 0, causes);
+    context->typelay_prefix_notifying = FALSE;
+}
+
+static gboolean typelay_process_sync(FcitxIMContext *self, GdkEventKey *event, guint32 state) {
+    const guint64 id = self->typelay_prefix_id;
+    const gboolean prefix = id && !self->typelay_prefix_submitted && event->type == GDK_KEY_PRESS
+        && !event->send_event && !(state & (1u << 31))
+        && event->state == self->typelay_prefix_state && event->keyval == self->typelay_prefix_key
+        && event->hardware_keycode == self->typelay_prefix_code && event->time == self->typelay_prefix_time
+        && event->window == self->typelay_prefix_window
+        && gdk_event_get_device(reinterpret_cast<GdkEvent *>(event)) == self->typelay_prefix_device;
+    if (prefix) self->typelay_prefix_submitted = TRUE;
+    typelay_changed(self, typelay_key_cause(event->keyval), prefix);
+    // The tag is already gone. Every output callback, including cause0, cancels.
+    gboolean completed = FALSE;
+    ++self->typelay_depth;
+    const gboolean handled = prefix
+        ? fcitx_g_client_typelay_process_key_sync_v1(self->client, event->keyval,
+            event->hardware_keycode, state, event->type == GDK_KEY_RELEASE, event->time, &completed)
+        : fcitx_g_client_process_key_sync(self->client, event->keyval, event->hardware_keycode,
+            state, event->type == GDK_KEY_RELEASE, event->time);
+    --self->typelay_depth;
+    if (prefix && self->typelay_prefix_id == id) {
+        if (completed) self->typelay_prefix_completed = TRUE;
+        else self->typelay_prefix_id = 0;
+    }
+    return handled;
+}
