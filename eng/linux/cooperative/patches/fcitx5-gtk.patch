+    if (!root || !GTK_IS_WINDOW(root) || !gtk_window_is_active(GTK_WINDOW(root))) return 0;
+    GtkWidget *focused = gtk_root_get_focus(root);
+    return focused && focused != widget ? TL_FCITX_DETACHED : 0;
