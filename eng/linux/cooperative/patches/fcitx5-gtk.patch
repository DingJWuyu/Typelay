+// Only the isolated fixture receives this candidate-selection action.
+static gboolean typelay_select_fixture(GtkWidget *widget) {
+    auto *self = static_cast<FcitxIMContext *>(g_object_get_data(G_OBJECT(widget), TL_FCITX_CONTEXT_V1));
+    if (!self || !FCITX_IS_IM_CONTEXT(self) || g_main_depth() != 1) return FALSE;
+    fcitx_g_client_select_candidate(self->client, 0);
+    return TRUE;
+}
+
+static gboolean typelay_deferred_switch_fixture(GtkWidget *widget) {
+    auto *self = static_cast<FcitxIMContext *>(g_object_get_data(G_OBJECT(widget), TL_FCITX_CONTEXT_V1));
+    if (!self || !FCITX_IS_IM_CONTEXT(self) || g_main_depth() != 1) return FALSE;
+    return fcitx_g_client_typelay_deferred_switch_fixture_v1(self->client);
+}
+
+static gboolean typelay_prepare_caret(GtkIMContext *context, GtkWidget *widget,
+                                      const TlFcitxStateV1 *baseline) {
+    if (!widget || !typelay_validate_local(context, widget, baseline)) return FALSE;
+    const gboolean text_view = G_OBJECT_TYPE(widget) == GTK_TYPE_TEXT_VIEW;
+    if (!text_view && !GTK_IS_ENTRY(widget)) return FALSE;
+    auto *self = FCITX_IM_CONTEXT(context);
+    if (self->typelay_preparing) return FALSE;
+    self->typelay_preparing = TRUE;
+    self->typelay_prepare_ok = TRUE;
+    self->typelay_prepare_serial = baseline->server_serial;
+    if (text_view) gtk_text_view_reset_im_context(GTK_TEXT_VIEW(widget));
+    else gtk_entry_reset_im_context(GTK_ENTRY(widget));
+    self->typelay_preparing = FALSE;
+    return self->typelay_prepare_ok;
+}
