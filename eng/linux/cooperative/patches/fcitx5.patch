+// This is a version-scoped source audit, not a trust decision based on an IM
+// name. Keep normal addon loading and input behavior unchanged on rejection.
+const char *typelayAddonGuard(Instance *instance) {
+    if (std::string_view(Instance::version()) != "5.1.22") {
+        return "unsupported-core-version";
+    }
+    // Only the explicit isolated launcher establishes these audited roots.
+    // No implicit trust in the system addon path or a same-named fallback.
+    const auto rootsValue = getEnvironment("TYPELAY_FCITX_AUDITED_ADDON_DIRS");
+    if (!rootsValue || rootsValue->empty()) {
+        return "missing-audited-addon-roots";
+    }
+    std::vector<std::filesystem::path> roots;
+    for (const auto &value : stringutils::split(*rootsValue, ":")) {
+        const std::filesystem::path path(value);
+        std::error_code error;
+        const auto canonical = std::filesystem::canonical(path, error);
+        if (!path.is_absolute() || error ||
+            !std::filesystem::is_directory(canonical, error) || error) {
+            return "invalid-audited-addon-roots";
+        }
+        roots.push_back(canonical);
+    }
+    if (roots.empty()) {
+        return "invalid-audited-addon-roots";
+    }
+    struct AuditedAddon {
+        const char *name;
+        const char *library;
+        const char *type;
+        const char *version;
+    };
+    static constexpr AuditedAddon audited[] = {
+        {"dbus", "libdbus", "SharedLibrary", "5.1.22"},
+        {"dbusfrontend", "libdbusfrontend", "SharedLibrary", "5.1.22"},
+        {"keyboard", "keyboard", "StaticLibrary", "5.1.22"},
+        {"pinyin", "libpinyin", "SharedLibrary", "5.1.14"},
+        {"punctuation", "libpunctuation", "SharedLibrary", "5.1.14"},
+        {"pinyinhelper", "libpinyinhelper", "SharedLibrary", "5.1.14"},
+        {"spell", "libspell", "SharedLibrary", "5.1.22"},
+        {"quickphrase", "libquickphrase", "SharedLibrary", "5.1.22"},
+        {"classicui", "libclassicui", "SharedLibrary", "5.1.22"},
+        {"wayland", "libwayland", "SharedLibrary", "5.1.22"},
+        {"waylandim", "libwaylandim", "SharedLibrary", "5.1.22"},
+        {"xcb", "libxcb", "SharedLibrary", "5.1.22"},
+        {"xim", "libxim", "SharedLibrary", "5.1.22"},
+        {"notifications", "libnotifications", "SharedLibrary", "5.1.22"},
+        {"notificationitem", "libnotificationitem", "SharedLibrary", "5.1.22"},
+        {"clipboard", "libclipboard", "SharedLibrary", "5.1.22"},
+        {"unicode", "libunicode", "SharedLibrary", "5.1.22"},
+        {"imselector", "libimselector", "SharedLibrary", "5.1.22"},
+        {"chttrans", "libchttrans", "SharedLibrary", "5.1.14"},
+        {"fullwidth", "libfullwidth", "SharedLibrary", "5.1.14"},
+        {"cloudpinyin", "libcloudpinyin", "SharedLibrary", "5.1.14"},
+        {"emoji", "libemoji", "SharedLibrary", "5.1.22"},
+        {"fcitx4frontend", "libfcitx4frontend", "SharedLibrary", "5.1.22"},
+        {"kimpanel", "libkimpanel", "SharedLibrary", "5.1.22"},
+        {"virtualkeyboard", "libvirtualkeyboard", "SharedLibrary", "5.1.22"},
+    };
+    auto &manager = instance->addonManager();
+    for (const auto &name : manager.loadedAddonNames()) {
+        const AuditedAddon *expected = nullptr;
+        for (const auto &candidate : audited) {
+            if (name == candidate.name) {
+                expected = &candidate;
+                break;
+            }
+        }
+        if (!expected) {
+            return "unaudited-loaded-addon";
+        }
+        const auto *info = manager.addonInfo(name);
+        if (!info || !manager.lookupAddon(name) || info->uniqueName() != name ||
+            info->type() != expected->type ||
+            info->library() != expected->library ||
+            info->version().toString() != expected->version) {
+            return "unaudited-addon-metadata";
+        }
+        if (info->type() == "SharedLibrary") {
+            const auto paths = manager.typelayLoadedLibraryPathsV1(name);
+            // Every audited addon uses one library without export/preload lists.
+            if (paths.size() != 1) {
+                return "unknown-addon-library-origin";
+            }
+            const std::filesystem::path path(paths.front());
+            std::error_code error;
+            const auto canonical = std::filesystem::canonical(path, error);
+            if (!path.is_absolute() || error ||
+                path.filename() != std::string(expected->library) + ".so") {
+                return "unaudited-addon-library-origin";
+            }
+            bool matched = false;
+            for (const auto &root : roots) {
+                if (canonical.parent_path() == root) {
+                    matched = true;
+                    break;
+                }
+            }
+            if (!matched) {
+                return "unaudited-addon-library-origin";
+            }
+        }
+    }
+    return nullptr;
+}
 
