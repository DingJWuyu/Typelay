+bool TempModeManager::typelayHasActiveModeV1(InputContext *inputContext) const {
+    FCITX_D();
+    std::string_view active = "none";
+    for (auto *mode : d->modes_.view()) {
+        if (mode->isActive(inputContext)) {
+            const auto name = mode->name();
+            active = name == "quickphraseState" ? "quickphrase"
+                : name == "clipboardState" ? "clipboard"
+                : name == "unicodeState" ? "unicode"
+                : name == "imselector" ? "imselector" : "other";
+            break;
+        }
+    }
+    const auto probe = getEnvironment("TYPELAY_FCITX_PROBE");
+    if (probe && *probe == "1") {
+        static thread_local std::string_view previous;
+        if (previous != active) {
+            previous = active;
+            FCITX_INFO() << "TypeLay active-mode=" << active;
+        }
+    }
+    return active != "none";
+}
