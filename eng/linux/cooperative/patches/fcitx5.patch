+std::vector<std::string>
+AddonManager::typelayLoadedLibraryPathsV1(const std::string &name) const {
+    FCITX_D();
+    auto *addon = d->addon(name);
+    if (addon && addon->loaded()) {
+        if (const auto *loader = findValue(d->loaders_, addon->info().type())) {
+            if (const auto *shared =
+                    dynamic_cast<const SharedLibraryLoader *>(loader->get())) {
+                return shared->typelayLoadedLibraryPathsV1(name);
+            }
+        }
+    }
+    return {};
+}
