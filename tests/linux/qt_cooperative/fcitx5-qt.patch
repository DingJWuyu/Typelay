+bool QFcitxPlatformInputContext::tlControlKey(const QKeyEvent *event) {
+    const bool release = event->type() == QEvent::KeyRelease;
+    if (tlConsumedKey_ && event->nativeScanCode() == tlConsumedScan_) {
+        if (release && !event->isAutoRepeat()) { tlConsumedKey_ = 0; tlConsumedScan_ = 0; }
+        return true;
+    }
+    // Never overwrite an outstanding pair. A distinct key follows the original
+    // input path; modifiers may change Qt::Key on the matching release.
+    if (tlConsumedKey_ || !event->nativeScanCode() || release ||
+        event->isAutoRepeat() || tlControl_) return false;
+    bool candidate = event->modifiers() == Qt::NoModifier &&
+        (event->key() == Qt::Key_Tab || event->key() == Qt::Key_Escape);
+    for (const auto &key : qApp->property(TypeLayFcitxQtControlKeysPropertyV1).toList()) {
+        if (key.metaType() == QMetaType::fromType<uint>() &&
+            key.toUInt() == event->nativeVirtualKey()) candidate = true;
+    }
+    if (!candidate) return false;
+    QPointer<QObject> actual(focusObjectWrapper());
+    QPointer<QObject> consumer(qApp->property(TypeLayFcitxQtConsumerPropertyV1).value<QObject *>());
+    auto *control = consumer ? qobject_cast<TypeLayFcitxQtControlV1 *>(consumer.data()) : nullptr;
+    if (!actual || actual != tlBound_ || !control) return false;
+    QPointer<QFcitxPlatformInputContext> self(this);
+    tlControl_ = true;
+    const bool consumed = control->filterControlKey(actual, const_cast<QKeyEvent *>(event));
+    if (!self) return consumed;
+    tlControl_ = false;
+    if (consumed) { tlConsumedKey_ = event->key(); tlConsumedScan_ = event->nativeScanCode(); }
+    return consumed;
+}
+
+// Observe actual replay delivery, which bypasses the original IM filter. A key
+// requested by field A may be delivered to field B after a same-window switch.
+bool QFcitxPlatformInputContext::eventFilter(QObject *object, QEvent *event) {
+    if (tlCooperate() && tlPendingForward && object == tlBound_ &&
+        (event->type() == QEvent::KeyPress || event->type() == QEvent::KeyRelease))
+        tlChanged(TlQtInput);
+    return QPlatformInputContext::eventFilter(object, event);
+}
