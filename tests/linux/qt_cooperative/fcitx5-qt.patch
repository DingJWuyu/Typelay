+// TypeLay 2026-10-12: research queue instrumentation. Original IM behavior
+// is unchanged unless TYPELAY_QT_PROBE is explicitly enabled for this process.
+bool tlProbe() { return qEnvironmentVariableIsSet("TYPELAY_QT_PROBE"); }
+void tlCount(const char *name, int delta) {
+    if (!tlProbe() || !qApp) return;
+    qApp->setProperty(name, qApp->property(name).toInt() + delta);
+}
+struct TlScope {
+    const char *name;
+    explicit TlScope(const char *n) : name(n) { tlCount(name, 1); }
+    ~TlScope() { tlCount(name, -1); }
+};
+template<class Base> class TlQueued final : public Base {
+    QPointer<QObject> application_;
+public:
+    template<class... Args> explicit TlQueued(Args&&... args)
+        : Base(std::forward<Args>(args)...), application_(qApp) {
+        tlCount("tlqtPendingForward", 1);
+    }
+    ~TlQueued() override {
+        if (application_) {
+            tlCount("tlqtPendingForward", -1);
+            tlCount("tlqtRetired", 1);
+        }
+    }
+};
+void tlEnqueue(QWindowSystemInterfacePrivate::WindowSystemEvent *event) {
+    Q_ASSERT(QThread::currentThread() == qApp->thread());
+    QWindowSystemInterfacePrivate::windowSystemEventQueue.append(event);
+    if (auto *dispatcher = QAbstractEventDispatcher::instance()) dispatcher->wakeUp();
+}
 
