+    const auto generation = d->typelayGeneration_;
+    auto *ic = d->icproxy_;
+    auto call = QDBusMessage::createMethodCall(ic->service(), ic->path(),
+        FcitxQtInputContextProxyImpl::staticInterfaceName(), "TypeLayProbeStateV1");
+    const auto reply = ic->connection().call(call, QDBus::Block, 25);
+    if (!alive || generation != d->typelayGeneration_ ||
+        reply.type() != QDBusMessage::ReplyMessage || reply.signature() != "tbbbb") return false;
+    const auto args = reply.arguments();
+    if (args.size() != 5) return false;
+    serial = args[0].toULongLong();
+    known = args[1].toBool();
+    pending = args[2].toBool();
+    composing = args[3].toBool();
+    focused = args[4].toBool();
+    return true;
+}
+
+bool FcitxQtInputContextProxy::typelayPrepareCaret(quint64 expected) {
+    Q_D(FcitxQtInputContextProxy);
+    if (!d->isValid() || d->typelayOutputDepth_ || d->typelayPreparing_ ||
+        d->typelayAppliedSerial_ != expected) return false;
+    QPointer<FcitxQtInputContextProxy> alive(this);
+    const auto generation = d->typelayGeneration_;
+    d->typelayPreparing_ = true;
+    const auto resetPreparing = qScopeGuard([alive, d] {
+        if (alive) d->typelayPreparing_ = false;
+    });
+    auto *ic = d->icproxy_;
+    auto call = QDBusMessage::createMethodCall(ic->service(), ic->path(),
+        FcitxQtInputContextProxyImpl::staticInterfaceName(), "TypeLayPrepareCaretV1");
+    call.setArguments({QVariant::fromValue<qulonglong>(expected)});
+    const auto reply = ic->connection().call(call, QDBus::Block, 25);
+    if (!alive || generation != d->typelayGeneration_ ||
+        reply.type() != QDBusMessage::ReplyMessage || reply.signature() != "a(uv)b") return false;
+    const auto args = reply.arguments();
+    if (args.size() != 2 || !args[1].toBool() ||
+        args[0].metaType() != QMetaType::fromType<QDBusArgument>()) return false;
+
+    // Decode and validate the entire original Fcitx DBus blocked-event batch
+    // before delivering any output. No new exported Qt metatypes are needed.
+    struct Event {
+        uint kind = 0;
+        QString text;
+        FcitxQtFormattedPreeditList preedit;
+        int position = 0;
+        uint first = 0, second = 0;
+        bool release = false;
+    };
+    QList<Event> events;
+    const auto batch = qvariant_cast<QDBusArgument>(args[0]);
+    batch.beginArray();
+    while (!batch.atEnd()) {
+        Event event;
+        QDBusVariant wrapped;
+        batch.beginStructure();
+        batch >> event.kind >> wrapped;
+        batch.endStructure();
+        const auto value = wrapped.variant();
+        if (event.kind == 0) {
+            if (value.metaType() != QMetaType::fromType<QString>()) return false;
+            event.text = value.toString();
+        } else {
+            if (value.metaType() != QMetaType::fromType<QDBusArgument>()) return false;
+            const auto payload = qvariant_cast<QDBusArgument>(value);
+            const auto signature = payload.currentSignature();
+            if (event.kind == 1 && signature == "(a(si)i)") {
+                payload.beginStructure();
+                payload >> event.preedit >> event.position;
+                payload.endStructure();
+            } else if (event.kind == 2 && signature == "(uub)") {
+                payload.beginStructure();
+                payload >> event.first >> event.second >> event.release;
+                payload.endStructure();
+            } else if (event.kind == 3 && signature == "(iu)") {
+                payload.beginStructure();
+                payload >> event.position >> event.first;
+                payload.endStructure();
+            } else return false;
+        }
+        events.append(std::move(event));
+    }
+    batch.endArray();
+    for (const auto &event : events) {
+        if (!d->typelayDeliver(generation, [&] {
+            switch (event.kind) {
+            case 0: Q_EMIT commitString(event.text); break;
+            case 1: Q_EMIT updateFormattedPreedit(event.preedit, event.position); break;
+            case 2: Q_EMIT forwardKey(event.first, event.second, event.release); break;
+            case 3: Q_EMIT deleteSurroundingText(event.position, event.first); break;
+            }
+        })) return false;
+    }
+    return alive && generation == d->typelayGeneration_;
+}
