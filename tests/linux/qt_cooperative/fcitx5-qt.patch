+// TypeLay 2026-10-12: exact-object cooperation for the original async IM path.
+void QFcitxPlatformInputContext::tlChanged(quint32 causes) {
+    ++tlEpoch_;
+    tlProofObject_.clear();
+    if (tlBound_ && (causes & TlQtInput)) ++tlFields_[tlBound_].inputEpoch;
+    Q_EMIT typelayStateChangedV1(tlBound_, causes);
+}
+
+void QFcitxPlatformInputContext::tlBind(QObject *actual) {
+    if (!tlCooperate() || tlBound_ == actual) return;
+    if (tlBound_ && tlBound_->property(TypeLayFcitxQtProviderPropertyV1).value<QObject *>() == this)
+        tlBound_->setProperty(TypeLayFcitxQtProviderPropertyV1, QVariant());
+    tlBound_ = actual;
+    if (actual) {
+        if (!tlFields_.contains(actual)) {
+            tlFields_.insert(actual, {++tlNextGeneration_, 0});
+            connect(actual, &QObject::destroyed, this, [this, actual]() {
+                tlFields_.remove(actual);
+                ++tlEpoch_;
+                tlProofObject_.clear();
+            });
+        }
+        actual->setProperty(TypeLayFcitxQtProviderPropertyV1,
+                            QVariant::fromValue(static_cast<QObject *>(this)));
+    }
+    tlChanged(TlQtFocus);
+}
+
+bool QFcitxPlatformInputContext::tlLocalClear(QObject *actual) const {
+    return tlCooperate() && !syncMode_ && !destroy_ && actual &&
+        QThread::currentThread() == thread() && actual == tlBound_ &&
+        actual == focusObjectWrapper() && lastWindow_ &&
+        lastWindow_ == focusWindowWrapper() && !tlPendingDbus &&
+        !tlPendingForward && !tlOutputDepth && preedit_.isEmpty() &&
+        commitPreedit_.isEmpty() && (!xkbComposeState_ ||
+        xkb_compose_state_get_status(xkbComposeState_.data()) != XKB_COMPOSE_COMPOSING);
+}
+
+bool QFcitxPlatformInputContext::inspect(QObject *actual, TypeLayFcitxQtStateV1 *state) {
+    if (!state || state->size != sizeof(*state) || state->version != 1 ||
+        tlInspecting_ || !tlCooperate() || syncMode_ || destroy_ ||
+        QThread::currentThread() != thread() || !actual || actual != tlBound_ ||
+        actual != focusObjectWrapper() || !lastWindow_ || lastWindow_ != focusWindowWrapper())
+        return false;
+    auto *hybrid = validICByWindow(lastWindow_);
+    auto *proxy = hybrid ? hybrid->typelayProxy() : nullptr;
+    if (!proxy || !proxy->isValid() || proxy->typelayOutputDepth()) return false;
+    QPointer<QObject> object(actual);
+    QPointer<QFcitxPlatformInputContext> self(this);
+    QPointer<FcitxQtInputContextProxy> remote(proxy);
+    const auto epoch = tlEpoch_;
+    const auto queueEpoch = tlQueueEpoch;
+    const auto generation = proxy->typelayGeneration();
+    quint64 serial = 0;
+    bool known = false, pending = false, composing = false, focused = false;
+    tlInspecting_ = true;
+    const bool ok = proxy->typelayProbe(serial, known, pending, composing, focused);
+    if (!self) return false;
+    tlInspecting_ = false;
+    if (!ok || !object || !remote || epoch != tlEpoch_ || queueEpoch != tlQueueEpoch ||
+        actual != tlBound_ || generation != proxy->typelayGeneration()) return false;
+    auto &context = tlContexts_[hybrid];
+    if (context.proxy != proxy || context.remoteGeneration != generation || !context.generation) {
+        const bool newProxy = context.proxy != proxy;
+        context = {proxy, generation, ++tlNextGeneration_};
+        connect(hybrid, &QObject::destroyed, this, [this, hybrid]() { tlContexts_.remove(hybrid); });
+        if (newProxy) connect(proxy, &QObject::destroyed, this, [this]() { tlChanged(TlQtBinding); });
+    }
+    const auto field = tlFields_.value(actual);
+    *state = TypeLayFcitxQtStateV1{};
+    state->contextGeneration = context.generation;
+    state->fieldGeneration = field.generation;
+    state->epoch = tlEpoch_;
+    state->inputEpoch = field.inputEpoch;
+    state->serverSerial = serial;
+    state->appliedSerial = proxy->typelayAppliedSerial();
+    state->flags = (known ? TlQtKnown : 0u) | (focused ? TlQtFocused : 0u) |
+        ((pending || tlPendingDbus || tlPendingForward || tlOutputDepth ||
+          serial != state->appliedSerial) ? TlQtPending : 0u) |
+        ((composing || !preedit_.isEmpty() || !commitPreedit_.isEmpty() ||
+          (xkbComposeState_ && xkb_compose_state_get_status(xkbComposeState_.data()) ==
+           XKB_COMPOSE_COMPOSING)) ? TlQtComposing : 0u);
+    tlProofObject_.clear();
+    if (state->flags == (TlQtKnown | TlQtFocused) && tlLocalClear(actual)) {
+        tlProof_ = *state;
+        tlProofQueueEpoch_ = tlQueueEpoch;
+        tlProofObject_ = actual;
+    }
+    return true;
+}
+
+bool QFcitxPlatformInputContext::validateLocal(QObject *actual, const TypeLayFcitxQtStateV1 *state) {
+    if (!state || state->size != sizeof(*state) || state->version != 1 ||
+        state->flags != (TlQtKnown | TlQtFocused) || actual != tlProofObject_ ||
+        tlInspecting_ || !tlLocalClear(actual) || tlProofQueueEpoch_ != tlQueueEpoch ||
+        state->epoch != tlEpoch_ || state->epoch != tlProof_.epoch ||
+        state->contextGeneration != tlProof_.contextGeneration ||
+        state->fieldGeneration != tlProof_.fieldGeneration ||
+        state->inputEpoch != tlFields_.value(actual).inputEpoch ||
+        state->serverSerial != tlProof_.serverSerial ||
+        state->appliedSerial != tlProof_.appliedSerial) return false;
+    auto *hybrid = validICByWindow(lastWindow_);
+    auto *proxy = hybrid ? hybrid->typelayProxy() : nullptr;
+    return proxy && proxy == tlContexts_.value(hybrid).proxy &&
+        proxy->isValid() && !proxy->typelayOutputDepth() &&
+        proxy->typelayGeneration() == tlContexts_.value(hybrid).remoteGeneration &&
+        proxy->typelayAppliedSerial() == state->appliedSerial;
+}
+
+bool QFcitxPlatformInputContext::prepareCaret(QObject *actual, const TypeLayFcitxQtStateV1 *state) {
+    if (!validateLocal(actual, state)) return false;
+    auto *hybrid = validICByWindow(lastWindow_);
+    auto *proxy = hybrid ? hybrid->typelayProxy() : nullptr;
+    if (!proxy) return false;
+    // Caller must freshly inspect and revalidate source/focus after this output batch.
+    tlProofObject_.clear();
+    return proxy->typelayPrepareCaret(state->serverSerial);
+}
