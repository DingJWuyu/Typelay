+// Fixture-only action through the same actual context, not a synthetic engine.
+extern "C" G_MODULE_EXPORT gboolean typelay_fcitx_probe_select_v1(GtkWidget *widget) {
+    auto *ref = static_cast<GWeakRef *>(g_object_get_data(G_OBJECT(widget), "typelay-fcitx-probe-v1"));
+    if (!ref || g_main_depth() != 1) return FALSE;
+    auto *self = static_cast<FcitxIMContext *>(g_weak_ref_get(ref));
+    if (!self) return FALSE;
+    fcitx_g_client_select_candidate(self->client, 0);
+    g_object_unref(self);
+    return TRUE;
+}
