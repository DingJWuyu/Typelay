+extern "C" G_MODULE_EXPORT gboolean typelay_fcitx_probe_inspect_v1(
+    GtkWidget *widget, guint64 *epoch, guint64 *serial, guint64 *delivered,
+    gboolean *known, gboolean *pending, gboolean *composing) {
+    auto *ref = static_cast<GWeakRef *>(g_object_get_data(G_OBJECT(widget), "typelay-fcitx-probe-v1"));
+    if (!ref || g_main_depth() != 1) return FALSE;
+    auto *self = static_cast<FcitxIMContext *>(g_weak_ref_get(ref));
+    if (!self) return FALSE;
+    gpointer owner = nullptr;
+    if (self->client_window) gdk_window_get_user_data(self->client_window, &owner);
+    gboolean valid = owner == widget && self->has_focus && self->typelay_depth == 0 && _use_sync_mode
+        && typelay_pending_replay == 0 && _key_snooper_id != 0;
+    if (valid) {
+        *epoch = self->typelay_epoch;
+        GError *error = nullptr;
+        valid = fcitx_g_client_typelay_probe_state_v1(self->client, serial, delivered,
+            known, pending, composing, &error);
+        g_clear_error(&error);
+        if (self->is_inpreedit || (self->preedit_string && *self->preedit_string)
+            || (self->xkbComposeState && xkb_compose_state_get_status(self->xkbComposeState) != XKB_COMPOSE_NOTHING))
+            *composing = TRUE;
+    }
+    g_object_unref(self);
+    return valid;
+}
