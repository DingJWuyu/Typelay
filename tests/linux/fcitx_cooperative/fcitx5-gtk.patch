+static gboolean typelay_inspect(GtkIMContext *context, GtkWidget *widget, TlFcitxStateV1 *state) {
+    auto refuse = [](const char *reason) -> gboolean {
+        if (g_getenv("TYPELAY_TRACE")) g_printerr("typelay-fcitx-inspect %s\n", reason);
+        return FALSE;
+    };
+    if (!state || state->size != sizeof(*state) || state->version != TL_FCITX_ABI_V1)
+        return refuse("abi");
+    if (!FCITX_IS_IM_CONTEXT(context)) return refuse("context");
+    if (!get_boolean_env("TYPELAY_FCITX_COOPERATIVE", FALSE)) return refuse("disabled");
+    if (g_main_depth() != 1) return refuse("main-depth");
+    auto *self = FCITX_IM_CONTEXT(context);
+    gpointer owner = nullptr;
+    if (self->client_window) gdk_window_get_user_data(self->client_window, &owner);
+    if (owner != widget) return refuse("owner");
+    if (!self->has_focus) return refuse("focus");
+    if (self->typelay_depth) return refuse("callback-depth");
+    if (!_use_sync_mode) return refuse("async-mode");
+    if (typelay_pending_replay) return refuse("pending-replay");
+    if (!_key_snooper_id) return refuse("snooper");
+    if (!fcitx_g_client_is_valid(self->client)) return refuse("client");
+    gboolean known = FALSE, pending = TRUE, composing = TRUE;
+    guint64 serial = 0, applied = 0;
+    GError *error = nullptr;
+    self->typelay_proof_valid = FALSE;
+    const gboolean valid = fcitx_g_client_typelay_probe_state_v1(self->client, &serial, &applied,
+        &known, &pending, &composing, &error);
+    if (!valid) {
+        const bool timeout = g_error_matches(error, G_IO_ERROR, G_IO_ERROR_TIMED_OUT)
+            || g_error_matches(error, G_DBUS_ERROR, G_DBUS_ERROR_TIMEOUT)
+            || g_error_matches(error, G_DBUS_ERROR, G_DBUS_ERROR_NO_REPLY);
+        const char *reason = timeout ? "rpc-timeout" : error ? "rpc-error" : "rpc-state";
+        g_clear_error(&error);
+        return refuse(reason);
+    }
+    g_clear_error(&error);
+    const guint localCompositionMask = (self->is_inpreedit ? 1u : 0u)
+        | ((self->preedit_string && *self->preedit_string) ? 2u : 0u)
+        | ((self->xkbComposeState && xkb_compose_state_get_status(self->xkbComposeState) != XKB_COMPOSE_NOTHING) ? 4u : 0u);
+    if (get_boolean_env("TYPELAY_FCITX_PROBE", FALSE)) {
+        static gint previousMask = -1;
+        const gint mask = static_cast<gint>(localCompositionMask | (composing ? 8u : 0u));
+        if (mask != previousMask) {
+            previousMask = mask;
