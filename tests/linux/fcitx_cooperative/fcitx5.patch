+    // Feasibility RPC, not a universal IM-idle contract. Caller must compare
+    // serial against outputs it has actually applied and bind field lifecycle.
+    std::tuple<uint64_t, bool, bool, bool, bool> typelayProbeStateV1() {
+        CHECK_SENDER_OR_RETURN {};
+        auto *engine = im_->instance()->inputMethodEngine(this);
+        const auto *entry = im_->instance()->inputMethodEntry(this);
+        auto report = [&](const char *reason) {
+            const std::string diagnostic = std::string(reason) + " engine="
+                + (entry ? entry->uniqueName() : "none");
+            if (diagnostic != typelayLastDiagnostic_) {
+                typelayLastDiagnostic_ = diagnostic;
+                FCITX_INFO() << "TypeLay probe " << path_.path() << " " << diagnostic;
+            }
+        };
+        if (!engine || !hasFocus()) {
+            report(!engine ? "no-engine" : "no-focus");
+            return {typelayOutputSerial_, false, true, true, hasFocus()};
+        }
+        try {
+            bool pending = true;
+            try {
+                pending = engine->call<IPinyinEngine::typelayHasPendingCommitV1>(this);
+            } catch (const std::exception &) {
+                pending = engine->call<IKeyboardEngine::typelayHasPendingCommitV1>(this);
+            }
+            // An old pinyin punctuation transaction survives deactivate/reset.
+            // Query only an already-loaded instance, also after engine switch.
+            if (auto *pinyin = im_->instance()->addonManager().lookupAddon("pinyin")) {
+                pending = pinyin->call<IPinyinEngine::typelayHasPendingCommitV1>(this) || pending;
+            }
+            report("known");
+            bool composing = im_->instance()->isComposing(this)
+                || !inputPanel().clientPreedit().empty()
+                || !inputPanel().preedit().empty() || bool(inputPanel().candidateList());
+            if (auto *quick = im_->instance()->addonManager().lookupAddon("quickphrase")) {
+                composing = quick->call<IQuickPhrase::typelayHasActiveModeV1>(this) || composing;
+            }
+            return {typelayOutputSerial_, true, pending, composing, hasFocus()};
+        } catch (const std::exception &) {
+            report("missing-transaction-capability");
+            return {typelayOutputSerial_, false, true, true, hasFocus()};
+        }
+    }
+
+    std::tuple<std::vector<DBusBlockedEvent>, bool> typelayPrepareCaretV1(uint64_t expected) {
+        CHECK_SENDER_OR_RETURN {};
+        if (blocked_) return std::make_tuple(std::vector<DBusBlockedEvent>{}, false);
+        const auto state = typelayProbeStateV1();
+        if (std::get<0>(state) != expected || !std::get<1>(state)
+            || std::get<2>(state) || std::get<3>(state) || !std::get<4>(state))
+            return std::make_tuple(std::vector<DBusBlockedEvent>{}, false);
+        setBlocked();
+        reset();
+        std::vector<DBusBlockedEvent> output;
+        setUnblocked(output);
+        return {std::move(output), true};
+    }
+
+    // Synthetic fixture action only. Keep the real Backspace + engine switch in
+    // one server callback so the 3ms old transaction cannot race the assertion.
+    bool typelayDeferredSwitchFixtureV1() {
+        CHECK_SENDER_OR_RETURN false;
+        if (getEnvironment("TYPELAY_FCITX_PROBE") != std::optional<std::string>("1")
+            || !hasFocus()) return false;
+        auto *pinyin = im_->instance()->addonManager().lookupAddon("pinyin");
+        if (!pinyin || im_->instance()->inputMethodEngine(this) != pinyin) return false;
+        processKeyEvent(FcitxKey_BackSpace, 22, 0, false, 0);
+        const bool oldPending = pinyin->call<IPinyinEngine::typelayHasPendingCommitV1>(this);
+        im_->instance()->setCurrentInputMethod(this, "keyboard-us", true);
+        const auto *entry = im_->instance()->inputMethodEntry(this);
+        const auto state = typelayProbeStateV1();
+        return oldPending && entry && entry->uniqueName() == "keyboard-us"
+            && std::get<1>(state) && std::get<2>(state);
+    }
