<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/windows/TypeLay.App/TypeLay.App.csproj" />
    <ProjectReference Include="../../../src/windows/TypeLay.Broker/TypeLay.Broker.csproj" Aliases="BrokerProduction" />
    <ProjectReference Include="../support/TypeLay.Platform.Windows/TypeLay.Platform.Windows.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../fixtures/TypeLay.DesktopFixture/PublicOnboardingActions.cs" Link="PublicOnboardingActions.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/BrowserFixtureProcess.cs" Link="BrowserFixtureProcess.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/HostedEmptyBrowserProfile.cs" Link="HostedEmptyBrowserProfile.cs" />
    <Compile Include="../support/BrowserWindows.cs" Link="BrowserWindows.cs" />
    <Compile Include="../support/BrowserWindows.SourceClick.cs" Link="BrowserWindows.SourceClick.cs" />
    <Compile Include="../support/SettingsPackageActions.cs" Link="SettingsPackageActions.cs" />
    <Compile Include="../support/SettingsLanguageActions.cs" Link="SettingsLanguageActions.cs" />
    <Compile Include="../support/SettingsPageActions.cs" Link="SettingsPageActions.cs" />
    <Compile Include="../support/SettingsSupportActions.cs" Link="SettingsSupportActions.cs" />
    <Compile Include="../support/ProcessImage.cs" Link="ProcessImage.cs" />
    <Compile Include="../support/OverlayPreviewObservation.cs" Link="OverlayPreviewObservation.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/ModelConsumerFixtureOwner.cs" Link="ModelConsumerFixtureOwner.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/HyPackageCheck.Processes.cs" Link="HyPackageCheck.Processes.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/HyPackageCheck.Report.cs" Link="HyPackageCheck.Report.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/OrdinaryNotepadCheck.Scenarios.cs" Link="OrdinaryNotepadCheck.Scenarios.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/OrdinaryNotepadCheck.Commands.cs" Link="OrdinaryNotepadCheck.Commands.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/NativeSourceSetup.cs" Link="NativeSourceSetup.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/ShellTrayObservation.cs" Link="ShellTrayObservation.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/ShellTraySelection.cs" Link="ShellTraySelection.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/HyPackageCheck.Mouse.cs" Link="HyPackageCheck.Mouse.cs" />
    <Compile Include="../fixtures/TypeLay.DesktopFixture/HyPackageCheck.WritebackClick.cs" Link="HyPackageCheck.WritebackClick.cs" />
  </ItemGroup>
  <Target Name="CopyProductionBrokerForDesktopTests" AfterTargets="Build">
    <ItemGroup>
      <_BrokerTestFiles Include="$(MSBuildThisFileDirectory)../../../src/windows/TypeLay.Broker/bin/$(Configuration)/net10.0-windows/TypeLay.Broker.*" />
      <_BrokerTestFiles Include="$(MSBuildThisFileDirectory)../../../src/windows/TypeLay.Broker/bin/$(Configuration)/net10.0-windows/TypeLay.NativeInput.dll" />
      <_BrokerTestFiles Include="$(MSBuildThisFileDirectory)../../../src/windows/TypeLay.App/bin/$(Configuration)/net10.0-windows/TypeLay.Practice.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BrokerTestFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
