<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>../../../../src/windows/TypeLay.App/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/windows/TypeLay.App/TypeLay.App.csproj" />
    <ProjectReference Include="../../../../src/windows/TypeLay.Broker/TypeLay.Broker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../support/TypeLay.Platform.Windows/TypeLay.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../support/BrowserWindows.cs" Link="BrowserWindows.cs" />
  </ItemGroup>
  <Target Name="CopyProductionBrokerForContinuousCheck" AfterTargets="Build">
    <ItemGroup>
      <_ContinuousBrokerFiles Include="$(MSBuildThisFileDirectory)../../../../src/windows/TypeLay.Broker/bin/$(Configuration)/net10.0-windows/TypeLay.Broker.*" />
      <_ContinuousBrokerFiles Include="$(MSBuildThisFileDirectory)../../../../src/windows/TypeLay.Broker/bin/$(Configuration)/net10.0-windows/TypeLay.NativeInput.dll" />
      <_ContinuousBrokerFiles Include="$(MSBuildThisFileDirectory)../../../../src/windows/TypeLay.App/bin/$(Configuration)/net10.0-windows/TypeLay.Practice.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ContinuousBrokerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
